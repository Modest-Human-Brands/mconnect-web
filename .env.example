VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_MCONNECT_API_URL=http://localhost:3001

# Sent as the `x-org-id` header; required to list and send emails.
VITE_DEFAULT_ORGANIZATION_ID=
# Notion page id of the team member that sends emails (optional).
VITE_MCONNECT_USER_ID=
# Sent as `x-api-key` on every API request (the backend rejects requests without it).
# In production set it as an environment variable on the running container, not at build time.
VITE_MCONNECT_API_KEY=

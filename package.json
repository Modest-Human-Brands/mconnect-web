{
  "name": "mconnect-web",
  "version": "0.0.1",
  "private": true,
  "description": "Web UI of MConnect",
  "license": "MIT",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modest-Human-Brands/mconnect-web.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "detect": "gitleaks git --verbose",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "test:unit": "vp test",
    "build": "vp build",
    "preview": "vp preview",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t mconnect-web:dev .",
    "docker:start": "docker run --detach --name mconnect-web-dev --env-file .env.prod -p 2000:8080 mconnect-web:dev"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.22.0",
    "@vueuse/core": "^14.4.0",
    "ofetch": "^1.5.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "0.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "engines": {
    "bun": "^1.2.9",
    "node": "^22.11.0 || ^24.14.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0"
  },
  "packageManager": "bun@1.4.0"
}